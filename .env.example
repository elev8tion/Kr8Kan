# ── Kr8Kan self-host env ───────────────────────────────────────────
# Copy to .env and fill in. Only the "Required" block is needed to boot.

# Required
NEXT_PUBLIC_BASE_URL=http://localhost:3310
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# NoCodeBackend data store (MySQL behind a REST data API) — the only backend.
# Server-only secrets: never expose these as NEXT_PUBLIC.
NCB_INSTANCE=
NCB_SECRET_KEY=
# Data API base URL (optional — this is the default)
# NCB_DATA_API_URL=https://app.nocodebackend.com/api/data
NEXT_PUBLIC_ALLOW_CREDENTIALS=true

# Dedicated ports (chosen to avoid 3000/3001/6379 clashes)
KR8KAN_WEB_PORT=3310
KR8KAN_REDIS_PORT=6380

# Auth (optional)
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_ALLOWED_DOMAINS=
NEXT_PUBLIC_DISABLE_SIGN_UP=
# One-click quick login (self-host/dev convenience). Bypasses email+password
# for a single operator. OFF by default — set KR8KAN_QUICK_LOGIN=true AND the
# NEXT_PUBLIC mirror to true to show the button + register the endpoint.
KR8KAN_QUICK_LOGIN=
NEXT_PUBLIC_QUICK_LOGIN=
KR8KAN_QUICK_LOGIN_EMAIL=
KR8KAN_QUICK_LOGIN_NAME=
# Social providers — set both halves of a pair to enable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=

# Email (optional — without SMTP, magic links are printed to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Kr8Kan <kr8kan@localhost>"
NEXT_PUBLIC_DISABLE_EMAIL=

# Storage (optional, S3-compatible — MinIO fine)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Redis (optional — in-memory rate limiting is used when unset)
REDIS_URL=
# REDIS_URL=redis://localhost:6380

# Pi workers (AI automation via your global ~/.pi agent layer)
KR8KAN_PI_WORKERS_ENABLED=true
PI_BIN=pi
PI_AGENT_HOME=/Users/kc/.pi
KR8KAN_PI_MODEL=
KR8KAN_PI_JOB_DIR=.kr8kan/jobs
# Dev agents in real project folders (worker "dev-task"): BOTH must be set.
# Tools stay off and folder runs stay blocked until you opt in here.
#
# This pair is what makes Kr8Kan a cockpit for your *other* projects rather
# than only for itself. A board's "Project folder" must sit inside one of
# these roots, so one board per repo:
#
#   board "Blocky"  -> /Users/kc/blocky   + `pnpm test`     + http://localhost:5173
#   board "Kr8Kan"  -> /Users/kc/Kr8Kan   + `pnpm test`     + http://localhost:3310
#
# Board settings always shows the Project folder field — its hint says
# whether tools are off or lists the allowed roots — but the Verify command
# and Dev URL fields only appear once a project folder is filled in. With no
# roots set they look missing rather than gated.
KR8KAN_PI_ALLOW_TOOLS=
# Colon-separated absolute paths boards may be linked to, e.g. /Users/kc/code:/Users/kc/projects
#
# Scope is a real security decision. A dev-task's shell can read anything
# under a root, not just the board's folder — pointing this at your home
# directory reaches ~/.ssh and other credentials. Naming the specific repos
# you actually drive from Kr8Kan is the safer shape. Edits are still confined
# to a detached git worktree and land as a patch a human applies.
KR8KAN_PI_PROJECT_ROOTS=
# Timeout for tool runs in ms (default 900000 = 15 min)
KR8KAN_PI_TOOL_TIMEOUT_MS=

# Agent browser (headless Chrome over CDP — screenshots, console capture,
# page snapshots for verification). Off unless BOTH of the first two are set:
# enabling it without naming a host gets you a browser that can open nothing.
#
# This is what powers a board's "Dev URL": after a dev-task's verify command
# passes, the runner opens that URL, screenshots it desktop and mobile, and
# reads its console. Console errors fail the job even when the command
# exited 0 — a green build that throws in the browser is not verified.
# Needs a system Chrome or Chromium; nothing is downloaded.
KR8KAN_BROWSER_ENABLED=
# Comma-separated (a colon already means "port" here), e.g. localhost:3310
#
# An entry with no port matches any port on that host, which is the usual
# choice when you drive several projects: `localhost,127.0.0.1` covers Vite
# on 5173, Next on 3000, Django on 8000 and the rest. Name ports explicitly
# to be stricter. Non-local addresses are refused regardless — hosts are
# resolved first, and private, loopback and link-local answers are rejected
# unless the entry itself named a local address, so an allowlisted public
# domain cannot resolve its way to cloud metadata.
KR8KAN_BROWSER_ALLOWED_HOSTS=
# Explicit Chrome/Chromium binary; discovery handles the usual locations
KR8KAN_BROWSER_CHROME_PATH=
# Per-command timeout in ms (default 30000)
KR8KAN_BROWSER_TIMEOUT_MS=
# Concurrent pages (default 2)
KR8KAN_BROWSER_MAX_PAGES=
# Chrome's sandbox needs user namespaces many containers do not grant.
# Turning it off is a real downgrade — set it only if your deployment needs it.
KR8KAN_BROWSER_NO_SANDBOX=

# MCP (optional)
KR8KAN_BASE_URL=http://localhost:3310
KR8KAN_API_TOKEN=

# Logging
LOG_LEVEL=info
LOG_FILE=
