{
  "name": "kr8kan",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:next": "pnpm -F @kr8kan/web dev",
    "db:migrate": "pnpm -F @kr8kan/db migrate",
    "db:generate": "pnpm -F @kr8kan/db generate",
    "db:push": "pnpm -F @kr8kan/db push",
    "db:studio": "pnpm -F @kr8kan/db studio",
    "lint": "turbo run lint",
    "format": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:fix": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "agents:worker": "./scripts/pi-worker.sh"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "^2.3.1",
    "typescript": "catalog:"
  }
}
