{
  "name": "kr8kan",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -e .env -- turbo run dev --parallel",
    "dev:next": "dotenv -e .env -- pnpm -F @kr8kan/web dev",
    "lint": "turbo run lint",
    "format": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:fix": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "agents:worker": "./scripts/pi-worker.sh",
    "app": "mkmacapp",
    "app:install": "mkmacapp --install"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "prettier": "catalog:",
    "turbo": "^2.3.1",
    "typescript": "catalog:"
  }
}
