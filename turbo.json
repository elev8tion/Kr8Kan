{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_BASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "BETTER_AUTH_ALLOWED_DOMAINS",
    "NEXT_PUBLIC_ALLOW_CREDENTIALS",
    "NEXT_PUBLIC_DISABLE_SIGN_UP",
    "NEXT_PUBLIC_DISABLE_EMAIL",
    "KR8KAN_QUICK_LOGIN",
    "NEXT_PUBLIC_QUICK_LOGIN",
    "KR8KAN_QUICK_LOGIN_EMAIL",
    "KR8KAN_QUICK_LOGIN_NAME",
    "POSTGRES_URL",
    "REDIS_URL",
    "KR8KAN_WEB_PORT",
    "KR8KAN_DOCS_PORT",
    "KR8KAN_POSTGRES_PORT",
    "KR8KAN_REDIS_PORT",
    "KR8KAN_ADMIN_API_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_SECURE",
    "EMAIL_FROM",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_BUCKET",
    "PI_BIN",
    "PI_AGENT_HOME",
    "KR8KAN_PI_WORKERS_ENABLED",
    "KR8KAN_PI_MODEL",
    "KR8KAN_PI_JOB_DIR",
    "KR8KAN_BASE_URL",
    "KR8KAN_API_TOKEN",
    "LOG_FILE",
    "LOG_LEVEL"
  ]
}
